# From your project in dTelecom Cloud
DTELECOM_API_KEY=
DTELECOM_API_SECRET=
DTELECOM_CLOUD_URL=https://cloud.dtelecom.org

# Optional: override webhook URL (auto-detected on Vercel)
# WEBHOOK_URL=https://your-tunnel-url/api/webhook

# Only on a test network: node registry used to verify webhooks
# SOLANA_REGISTRY_AUTHORITY=
# SOLANA_NETWORK_HOST_HTTP=https://api.devnet.solana.com
